name: Build LifeTrack APK

on:
  push:
    branches: [main]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:

      - name: Checkout repo
        uses: actions/checkout@v4

      - name: Set up Java 17
        uses: actions/setup-java@v4
        with:
          java-version: '17'
          distribution: 'temurin'

      - name: Set up Android SDK
        uses: android-actions/setup-android@v3

      - name: Set up Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'

      - name: Install Capacitor CLI
        run: npm install -g @capacitor/cli@6

      - name: Initialize Capacitor Android project
        run: npx cap add android 2>&1 || echo "Android already exists"

      - name: Copy web assets
        run: npx cap copy 2>&1 || echo "Copy completed"

      - name: Sync Capacitor
        run: npx cap sync android 2>&1 || echo "Sync completed"

      - name: List Android directory
        run: ls -la android/ || echo "No android directory"

      - name: Make Gradlew executable
        run: chmod +x android/gradlew 2>/dev/null || echo "Gradlew not found yet"

      - name: Build Android APK (Debug)
        run: |
          cd android
          ./gradlew clean
          ./gradlew assembleDebug --stacktrace
        continue-on-error: true

      - name: List output directory
        run: find android -name "*.apk" -type f 2>/dev/null || echo "No APK files found"

      - name: Upload APK if built
        uses: actions/upload-artifact@v4
        if: hashFiles('android/app/build/outputs/apk/debug/app-debug.apk') != ''
        with:
          name: LifeTrack-APK
          path: android/app/build/outputs/apk/debug/app-debug.apk
          retention-days: 30

      - name: Create Release
        uses: softprops/action-gh-release@v2
        if: hashFiles('android/app/build/outputs/apk/debug/app-debug.apk') != ''
        with:
          tag_name: v1.1.0-${{ github.run_number }}
          name: LifeTrack v1.1.0 Build ${{ github.run_number }}
          body: "Download app-debug.apk to install on Android"
          files: android/app/build/outputs/apk/debug/app-debug.apk
          token: ${{ secrets.GITHUB_TOKEN }}
